{
  "redirects": [
    {
      "source": "/mini-crm",
      "destination": "/mini-crm/index.html",
      "permanent": true
    },
    {
      "source": "/mini-crm/",
      "destination": "/mini-crm/index.html",
      "permanent": true
    },
    {
      "source": "/team-crm",
      "destination": "/team-crm/index.html",
      "permanent": true
    },
    {
      "source": "/team-crm/",
      "destination": "/team-crm/index.html",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/team-crm/:path*",
      "destination": "/team-crm/:path*"
    },
    {
      "source": "/mini-crm/:path*",
      "destination": "/mini-crm/:path*"
    },
    {
      "source": "/((?!team-crm|mini-crm).*)",
      "destination": "/index.html"
    }
  ]
}
